VERSION 1

DESCRIPTION >
    Event type counts for a dataroom (navigation flow)

NODE endpoint
SQL >
    %
    SELECT
        event_type,
        count() AS event_count
    FROM dataroom_nav__v1
    WHERE dataroom_id = {{ String(dataroom_id, required=True) }}
        AND timestamp >= {{ Int64(since, required=True) }}
    GROUP BY event_type
    ORDER BY event_count DESC

TYPE ENDPOINT
